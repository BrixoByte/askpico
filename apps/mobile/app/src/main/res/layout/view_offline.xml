<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen load-failure state. ScrollView + fillViewport keeps the
     centered layout intact under large font scales and small screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingVertical="48dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_icon_tile"
            android:padding="18dp">

            <ImageView
                android:id="@+id/error_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_error_offline" />
        </FrameLayout>

        <TextView
            android:id="@+id/error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="@color/ink_muted"
            android:textSize="15sp" />

        <!-- Inline hint (e.g. "still offline") — replaces the old toast so the
             state never has to leave the screen to be communicated. -->
        <TextView
            android:id="@+id/error_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_mid_banner"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:textColor="@color/warn_ink"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:minHeight="48dp"
            android:paddingHorizontal="36dp"
            android:text="@string/error_retry"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/open_browser_button"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/error_open_browser"
            android:textColor="@color/brand_600" />

    </LinearLayout>
</ScrollView>
